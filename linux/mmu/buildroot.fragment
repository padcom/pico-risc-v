# Buildroot settings for the mmu flavor, applied on top of Buildroot's
# configs/qemu_riscv32_virt_defconfig (see linux/build.sh).

# CPU: exactly what the emulator implements, RV32IMAFDC (RV32GC) with the
# hard-float ABI. The MMU itself is on by default. Changing these rebuilds
# everything from scratch (linux/build.sh notices).
BR2_riscv_custom=y
BR2_RISCV_ISA_RVM=y
BR2_RISCV_ISA_RVA=y
BR2_RISCV_ISA_RVF=y
BR2_RISCV_ISA_RVD=y
BR2_RISCV_ISA_RVC=y
BR2_RISCV_ABI_ILP32D=y

# C library: glibc (Buildroot's default); it has the threads and wide
# characters GLib, and so mc, need.
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y

# System
BR2_TARGET_GENERIC_HOSTNAME="riscv"
BR2_TARGET_GENERIC_ISSUE="Welcome to risc-emulator Linux"
# Network: eth0 (the emulator's virtio-net card) configured by DHCP at boot.
# Boot waits up to 15 s for eth0 to appear, so attach the card (--net).
BR2_SYSTEM_DHCP="eth0"

# Root filesystem: an ext4 disk image the emulator attaches as a virtio
# block device (/dev/vda). The file is sparse, so 256M is an upper bound.
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="256M"
BR2_TARGET_ROOTFS_EXT2_LABEL="rootfs"
# BR2_TARGET_ROOTFS_CPIO is not set
# BR2_TARGET_ROOTFS_INITRAMFS is not set

# Firmware: OpenSBI's fw_dynamic.bin goes at the start of RAM; the emulator
# tells it where the kernel is (struct fw_dynamic_info in a2), so it needs no
# built-in load addresses and leaves the device tree where the emulator put it.
# OpenSBI is built for exactly our CPU (passed via the environment, which its
# Makefile honours for PLATFORM_RISCV_ISA).
BR2_TARGET_OPENSBI_INSTALL_DYNAMIC_IMG=y
# BR2_TARGET_OPENSBI_INSTALL_JUMP_IMG is not set
BR2_TARGET_OPENSBI_ADDITIONAL_VARIABLES="PLATFORM_RISCV_ISA=rv32imafdc_zicsr_zifencei"

# Packages
BR2_PACKAGE_NCURSES=y
BR2_PACKAGE_MC=y
# curl with HTTPS: OpenSSL and the CA certificates to verify servers with
# (certificate dates also need the right time: the emulator has an RTC).
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_LIBCURL_OPENSSL=y
BR2_PACKAGE_CA_CERTIFICATES=y
