# Buildroot settings for the kernel and firmware, applied on top of Buildroot's
# configs/qemu_riscv64_virt_defconfig (see linux/kernel/build.sh).

# CPU: exactly what the emulator implements, RV64IMAFDC (RV64GC, what Debian
# requires) with the hard-float ABI; the MMU (Sv39) is on by default.
# Changing these, or the toolchain, rebuilds everything from scratch
# (build.sh notices).
BR2_RISCV_64=y
BR2_riscv_custom=y
BR2_RISCV_ISA_RVM=y
BR2_RISCV_ISA_RVA=y
BR2_RISCV_ISA_RVF=y
BR2_RISCV_ISA_RVD=y
BR2_RISCV_ISA_RVC=y
BR2_RISCV_ABI_LP64D=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y

# Only the kernel and the firmware: Debian's disk is built separately
# (linux/debian/), so no init, shell or root filesystem image.
BR2_INIT_NONE=y
BR2_SYSTEM_BIN_SH_NONE=y
# BR2_PACKAGE_BUSYBOX is not set
# BR2_TARGET_ROOTFS_TAR is not set
# BR2_TARGET_ROOTFS_CPIO is not set
# BR2_TARGET_ROOTFS_INITRAMFS is not set

# Firmware: OpenSBI's fw_dynamic.bin goes at the start of RAM; the emulator
# tells it where the kernel is (struct fw_dynamic_info in a2), so it needs no
# built-in load addresses and leaves the device tree where the emulator put it.
# OpenSBI is built for exactly our CPU (passed via the environment, which its
# Makefile honours for PLATFORM_RISCV_ISA).
BR2_TARGET_OPENSBI_INSTALL_DYNAMIC_IMG=y
# BR2_TARGET_OPENSBI_INSTALL_JUMP_IMG is not set
BR2_TARGET_OPENSBI_ADDITIONAL_VARIABLES="PLATFORM_RISCV_ISA=rv64imafdc_zicsr_zifencei"
