# Packages installed on top of Debian's minimal base system (mmdebstrap's
# minbase: dpkg, coreutils, bash, ...), one per line. Their dependencies come
# along; recommended packages don't. Change it and run `npm run
# debian:build` again, or install more later with apt inside the guest.

# Boot and services
systemd-sysv
udev
dbus

# Network: systemd-networkd (part of systemd) configures eth0 by DHCP,
# systemd-resolved does DNS.
systemd-resolved
netbase
iproute2
iputils-ping
ca-certificates
curl

# Packages; whiptail gives debconf's questions (asked by some packages while
# they install) a dialog interface.
apt
whiptail

# Everyday tools
procps
less
nano
