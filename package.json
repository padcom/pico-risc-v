{
  "name": "risc-emulator",
  "version": "0.1.0",
  "description": "RISC-V (RV32GC / RV64GC) system emulator in TypeScript, with its CPU core in Rust/WebAssembly, that boots Linux",
  "type": "module",
  "scripts": {
    "build": "npm run build:wasm --silent && tsc -p tsconfig.build.json",
    "build:wasm": "node scripts/build-wasm.ts",
    "build:examples": "make -C examples",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build-wasm.ts test && vitest run",
    "test:float": "bash hart/testfloat.sh",
    "test:watch": "vitest",
    "bench": "npm run build --silent && make -s -C examples && node scripts/bench.ts",
    "start": "node scripts/start.ts",
    "start:rv64": "node scripts/start.ts rv64",
    "start:debian": "node scripts/start.ts debian",
    "start:nommu": "node scripts/start.ts nommu",
    "linux": "npm run build --silent && node dist/cli.js",
    "linux:build": "FLAVOR=mmu bash linux/build.sh",
    "linux:rv64:build": "FLAVOR=rv64 bash linux/build.sh",
    "linux:nommu:build": "FLAVOR=nommu bash linux/build.sh",
    "debian:build": "bash linux/debian/build.sh",
    "linux:nommu:image": "node scripts/linux-image.ts"
  },
  "keywords": [
    "risc-v",
    "emulator"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "bin": {
    "risc-emulator": "dist/cli.js"
  }
}
