{
  "name": "risc-emulator",
  "version": "0.1.0",
  "description": "RISC-V (RV32IMA) system emulator in TypeScript that boots Linux",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:examples": "make -C examples",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "npm run build --silent && node dist/cli.js",
    "linux:image": "node scripts/linux-image.ts",
    "linux:build": "bash linux/build.sh",
    "linux": "npm run build --silent && node scripts/linux-image.ts && node dist/cli.js images/linux/Image"
  },
  "keywords": [
    "risc-v",
    "emulator"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "bin": {
    "risc-emulator": "dist/cli.js"
  }
}
