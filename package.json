{
  "name": "risc-emulator",
  "version": "0.1.0",
  "description": "RISC-V (RV64GC) system emulator in TypeScript, with its CPU core in Rust/WebAssembly, that boots Debian",
  "type": "module",
  "scripts": {
    "build": "npm run build:wasm --silent && tsc -p tsconfig.build.json",
    "build:wasm": "node scripts/build-wasm.ts",
    "build:examples": "make -C examples",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build-wasm.ts test && vitest run",
    "test:float": "bash hart/testfloat.sh",
    "test:watch": "vitest",
    "bench": "npm run build --silent && make -s -C examples && node scripts/bench.ts",
    "start": "node scripts/start.ts",
    "kernel:build": "bash linux/kernel/build.sh",
    "debian:build": "bash linux/debian/build.sh",
    "emulator": "npm run build --silent && node dist/cli.js"
  },
  "keywords": [
    "risc-v",
    "emulator"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "bin": {
    "risc-emulator": "dist/cli.js"
  }
}
